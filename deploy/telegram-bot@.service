# systemd template unit for a single Telegram bot process.
# %i = the bot entry-point filename WITHOUT the .py extension.
#
# Install (as root):
#   cp deploy/telegram-bot@.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now telegram-bot@example_posting_bot
#
# One instance per bot; deploy/install.sh enables the full set.

[Unit]
Description=Telegram bot (%i)
After=network-online.target
Wants=network-online.target
# Give a crash-looping bot some breathing room instead of hammering Telegram:
# stop retrying after 5 failed starts within 300s. These two MUST live in
# [Unit] — systemd moved them here in v229, and it silently ignores them
# (logging "Unknown key name") if they are left in [Service].
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/telegram-bots
ExecStart=/opt/telegram-bots/.venv/bin/python -B /opt/telegram-bots/%i.py
Restart=on-failure
RestartSec=10
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
