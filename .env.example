# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Every variable is prefixed with the bot's stable internal name, so adding a
# second posting bot means adding a second prefixed pair below — no code change
# in the shared engine.

# --- Telegram bot tokens (from @BotFather) ---
IMAGEBOARD_SEARCH_TELEGRAM_TOKEN=replace-me
IMAGEBOARD_NOTIFIER_TELEGRAM_TOKEN=replace-me
EXAMPLECHANNEL_TELEGRAM_TOKEN=replace-me

# --- Target channel for the posting bot ---
# Either @channelusername or the numeric -100... id.
EXAMPLECHANNEL_CHANNEL_ID=replace-me

# --- Operator access ---
# Numeric Telegram user id. Every command handler checks against this, so the
# bots only ever answer their owner.
BOTS_ALLOWED_USER_ID=replace-me

# --- Optional runtime overrides (defaults shown) ---
EXAMPLECHANNEL_BOT_TIMEZONE=UTC

# Minimum post score for an automatic notification.
IMAGEBOARD_NOTIFIER_SCORE_THRESHOLD=10
# Minimum score for the /top and /hot commands.
IMAGEBOARD_NOTIFIER_TOP_SCORE_THRESHOLD=20
IMAGEBOARD_NOTIFIER_HOT_SCORE_THRESHOLD=10
# How many API pages to scan per poll, and how often to poll.
IMAGEBOARD_NOTIFIER_DANBOORU_PAGES=10
IMAGEBOARD_NOTIFIER_POLL_INTERVAL_SECONDS=600
# Hard cap on a single media download held in memory.
IMAGEBOARD_NOTIFIER_MAX_DOWNLOAD_BYTES=51380224
IMAGEBOARD_SEARCH_MAX_DOWNLOAD_BYTES=51380224
IMAGEBOARD_SEARCH_SEND_DELAY_SECONDS=0.8
